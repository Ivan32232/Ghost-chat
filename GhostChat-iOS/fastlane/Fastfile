default_platform(:ios)

# App Store Connect API Key — полностью автономная подпись без пароля
ASC_KEY_ID = "45K8SKG77G"
ASC_ISSUER_ID = "b7534b54-e06b-4ae2-a7f0-0b3871205e98"
ASC_KEY_PATH = File.expand_path("../../deploy/keys/AuthKey_45K8SKG77G.p8")

platform :ios do

  before_all do
    # Подключаем App Store Connect API для автоматической подписи
    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_PATH,
      in_house: false
    )
  end

  desc "Build + upload to Firebase App Distribution (1 min delivery, no TestFlight wait)"
  lane :beta do
    # Auto-increment build number
    increment_build_number(xcodeproj: "GhostChat.xcodeproj")

    # Automatic code signing via App Store Connect API
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "GhostChat.xcodeproj",
      team_id: "G2VZKDYV38"
    )

    # Build IPA (ad-hoc for Firebase distribution)
    build_app(
      project: "GhostChat.xcodeproj",
      scheme: "GhostChat",
      export_method: "ad-hoc",
      output_directory: "./build",
      output_name: "GhostChat.ipa",
      export_options: {
        signingStyle: "automatic",
        teamID: "G2VZKDYV38"
      }
    )

    # Upload to Firebase App Distribution
    firebase_app_distribution(
      app: "1:930634724890:ios:5801c0c119f665b6a243a3",
      groups: "testers",
      release_notes: "Build #{lane_context[SharedValues::BUILD_NUMBER]} — #{Time.now.strftime('%Y-%m-%d %H:%M')}",
      service_credentials_file: File.expand_path("../../deploy/keys/firebase-sa.json")
    )

    UI.success "✅ Build #{lane_context[SharedValues::BUILD_NUMBER]} uploaded to Firebase App Distribution!"
  end

  desc "Build + upload to TestFlight (App Store submission)"
  lane :release do
    increment_build_number(xcodeproj: "GhostChat.xcodeproj")

    build_app(
      project: "GhostChat.xcodeproj",
      scheme: "GhostChat",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "GhostChat.ipa"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true
    )

    UI.success "✅ Build uploaded to TestFlight!"
  end

  desc "Just build (simulator, no signing)"
  lane :build_only do
    build_app(
      project: "GhostChat.xcodeproj",
      scheme: "GhostChat",
      destination: "generic/platform=iOS Simulator",
      configuration: "Debug",
      derived_data_path: "./DerivedData",
      skip_archive: true
    )
  end

end
