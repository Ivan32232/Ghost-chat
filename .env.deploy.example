# Ghost Chat v2 — deploy configuration
#
# Copy to .env.deploy (gitignored) and fill in values:
#   cp .env.deploy.example .env.deploy
#
# Used by scripts/deploy-server.sh.

# SSH target (production server)
DEPLOY_SSH_HOST=<ip-or-hostname>
DEPLOY_SSH_USER=root
DEPLOY_SSH_KEY=~/.ssh/your-deploy-key

# Public domain used for health/ws/landing smoke tests
DEPLOY_DOMAIN=ghostchat.one

# Remote paths — defaults match the current production layout
DEPLOY_REMOTE_DIR=/root/kordar/deploy
DEPLOY_REMOTE_SRC_ROOT=/root/kordar
