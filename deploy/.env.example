# Ghost Chat Production Environment
# Copy to .env and fill in values: cp .env.example .env

# TURN server shared secret (generate: openssl rand -hex 32)
# MUST match static-auth-secret in turnserver.conf
TURN_SECRET=your_turn_secret_here
TURN_DOMAIN=your.domain.com

# APNs Push (iOS) — get from Apple Developer > Keys
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_team_id
APNS_BUNDLE_ID=com.ivanpokhvalitov.ghostchat

# FCM Push (Android) — download service account JSON from:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
# Place the file in deploy/keys/firebase-sa.json
