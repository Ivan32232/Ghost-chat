# Ghost Chat v2 — Environment Variables
# Copy to .env: cp .env.example .env
#
# DEV:  docker compose up ghost-chat          (no .env needed, uses dev defaults)
# DEV:  docker compose --profile dev up       (ghost-chat + coturn without TLS)
# PROD: docker compose --profile prod up -d   (all services including nginx + certbot)

# ============================================================
# Server mode
# ============================================================

# "production" = requires TURN_SECRET, enables push auth, TRUST_PROXY
# "development" (default) = uses dev defaults, no secrets required
NODE_ENV=development

# Set to 1 ONLY when server is behind YOUR reverse proxy (nginx)
# Never set to 1 if the server is directly exposed to the internet
TRUST_PROXY=0

# Port mapping: host port → container port 3000
# In prod with nginx, set to something like 127.0.0.1:3000 (not exposed)
HOST_PORT=3000

# ============================================================
# TURN server (WebRTC relay)
# ============================================================

# Shared secret for HMAC-SHA1 credential generation
# Must match static-auth-secret in turnserver.conf
# In dev mode: auto-generates a dev secret if empty (loud warning in logs)
# In production: REQUIRED — server will not start without it
TURN_SECRET=

# TURN server hostname — used in TURN URLs returned to clients
# Dev: localhost (default)
# Prod: your domain (e.g., ghostchat.one)
TURN_DOMAIN=localhost

# ============================================================
# APNs push notifications (iOS)
# ============================================================

# Apple Push Notification Service key from App Store Connect
# Without these, iOS push notifications are disabled (server still runs)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.kordar.ghostchat

# APNs key file: place AuthKey_XXXX.p8 in deploy/keys/AuthKey.p8

# ============================================================
# FCM push notifications (Android)
# ============================================================

# Firebase Cloud Messaging service account
# Without this, Android push notifications are disabled (server still runs)
# Place firebase service account JSON in deploy/keys/firebase-sa.json

# ============================================================
# Production only
# ============================================================

# For prod profile, ensure these directories exist:
# deploy/ssl/ghostchat.one/fullchain.pem
# deploy/ssl/ghostchat.one/privkey.pem
# deploy/keys/AuthKey.p8
# deploy/keys/firebase-sa.json
